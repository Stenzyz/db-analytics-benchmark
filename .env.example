# Скопируйте в .env и при необходимости поправьте. Значения только для локального стенда.

# ClickHouse
CH_USER=bench
CH_PASSWORD=bench
CH_DB=bench
CH_HTTP_PORT=8123
CH_TCP_PORT=9000

# PostgreSQL
PG_USER=bench
PG_PASSWORD=bench
PG_DB=bench
PG_PORT=5432

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DB=bench
MYSQL_USER=bench
MYSQL_PASSWORD=bench
MYSQL_PORT=3306

# Сколько строк грузить в ClickHouse из источника (0 = весь доступный объём).
# Рекомендация: начните со 100_000_000 и увеличивайте, если позволяет диск и время.
CH_MAX_ROWS=100000000

# Сколько строк переносить в PostgreSQL и MySQL для эксперимента Э5.
# Берётся столько, сколько эти СУБД принимают за разумное время.
SUBSET_ROWS=50000000
